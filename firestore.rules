rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'admin@gcc.com';
    }

    function isGatekeeper() {
      return isVerified() && (
        request.auth.token.email == 'admin@gcc.com' ||
        request.auth.token.email.matches('qrscanner.*@gcc.com')
      );
    }

    match /attendees/{userId} {
      // Attendees read their own pass; verified gatekeepers and admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isGatekeeper());

      // Only the authenticated user can create their initial pass record
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.status == 'REGISTERED'
        && request.resource.data.tier in [
          'REGULAR', 'VIP_SILVER', 'VIP_GOLD', 'VIP_PLATINUM',
          'TEAM_MEMBER', 'VENDOR', 'ASSOCIATE'
        ]
        && request.resource.data.keys().hasAll([
          'uid', 'fullName', 'email', 'ticketCode', 'tier',
          'wristbandColor', 'status', 'createdAt', 'referralSource'
        ]);

      // Gate staff can update status, check-in metadata, and multi-day attendance marks
      allow update: if isAdmin() || (
        isGatekeeper() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'checkedInAt', 'checkedInFullDate', 'checkedInBy', 'daysAttended'])
      );

      allow delete: if isAdmin();
    }
  }
}
