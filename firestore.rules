rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // Check both hardcoded admin email and the 'role' field if available
      return isAuthenticated() && (
        request.auth.token.email == 'admin@gcc.com' ||
        get(/databases/$(database)/documents/attendees/$(request.auth.uid)).data.role == 'executive_admin'
      );
    }

    function isGatekeeper() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@gcc.com' ||
        request.auth.token.email.matches('qrscanner.*@gcc.com') ||
        get(/databases/$(database)/documents/attendees/$(request.auth.uid)).data.role == 'gatekeeper' ||
        get(/databases/$(database)/documents/attendees/$(request.auth.uid)).data.role == 'executive_admin'
      );
    }

    match /attendees/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isGatekeeper());

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.status == 'REGISTERED'
        && request.resource.data.keys().hasAll([
          'uid', 'fullName', 'email', 'ticketCode', 'tier',
          'wristbandColor', 'status', 'createdAt', 'referralSource'
        ]);

      allow update: if isAdmin() || (
        isGatekeeper() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'checkedInAt', 'checkedInFullDate', 'checkedInBy', 'daysAttended'])
      );

      allow delete: if isAdmin();
    }

    // VIP Invitations
    match /vipInvitations/{inviteId} {
      // Unauthenticated users can read to validate link
      allow read: if true;
      // Only admins can create/manage invites
      allow create, update, delete: if isAdmin();
    }

    // Event Stats
    match /eventStats/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
