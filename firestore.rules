rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    function isAttendee() {
      return hasRole('attendee') || isGatekeeper();
    }

    function isGatekeeper() {
      return hasRole('gatekeeper') || isSupervisor();
    }

    function isSupervisor() {
      return hasRole('gate_supervisor') || isAdmin();
    }

    function isAdmin() {
      return hasRole('executive_admin');
    }

    // --- Collection Rules ---

    match /attendees/{userId} {
      // Attendee can only read their own pass.
      // Gatekeeper can read any pass for validation.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isGatekeeper());

      // Attendees cannot create their own records directly anymore; Cloud Function does it.
      // However, we might allow it if we want to support some edge cases, but the prompt says
      // "Move ticket issuance to trusted server-side logic."
      // So we'll disable direct client creation of attendees.
      allow create: if false;

      // Only admins or supervisors can modify sensitive fields.
      // Gatekeepers can only update check-in status and metadata.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isSupervisor() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['accessRevoked', 'status', 'daysAttended', 'checkedInAt', 'checkedInFullDate', 'checkedInBy'])) ||
        (isGatekeeper() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'daysAttended', 'checkedInAt', 'checkedInFullDate', 'checkedInBy']) &&
          // Ensure they don't revoke access
          request.resource.data.accessRevoked == resource.data.accessRevoked)
      );

      // Attendees can never modify their own records.
      // ticketCode, tier, wristbandColor are IMMUTABLE after creation by server.

      allow delete: if isAdmin();
    }

    match /vipInvitations/{invitationId} {
      // Only admins can manage invitations.
      // Public can read an invitation if they have the ID (to validate in Function, but also for UI hints).
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /operators/{operatorId} {
      // Only admins can see and manage operators.
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      // Only admins can see audit logs.
      // System (Functions) will write to them.
      allow read: if isAdmin();
      allow write: if false; // Only server-side writes
    }

    match /scanEvents/{eventId} {
      allow read: if isGatekeeper();
      allow write: if false;
    }

    match /eventStats/{statId} {
      allow read: if isSupervisor();
      allow write: if false; // Only server-side writes
    }

    match /gateStats/{statId} {
        allow read: if isGatekeeper();
        allow write: if isAdmin();
    }
  }
}
